# Shared look of every recording. Source'd by each tape; the tape sets its own Output.
Set Shell "bash"
Set FontSize 17
Set Width 1280
Set Padding 18
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms
Set Framerate 15
Set WindowBar Colorful
Set WaitPattern /\$ *$/
Set WaitTimeout 120s
Set BorderRadius 8
