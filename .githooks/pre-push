#!/bin/sh
# Refuse any push that does not go through the no-mistakes gate.
# Git passes the remote name as $1 and its URL as $2. Enable per clone with:
#   git config core.hooksPath .githooks
case "$1" in
  no-mistakes) exit 0 ;;
esac
echo "pre-push: refusing push to '$1'. Push through: git push no-mistakes <branch>" >&2
exit 1
